{
    "name": "tlfb-calendar",
    "version": "0.1.6",
    "private": true,
    "main": "desktop/main.cjs",
    "description": "Offline Timeline Followback research calendar",
    "author": "TLFB Calendar contributors",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "test": "node --test tests/tlfb.test.mjs tests/research.test.mjs tests/workspace.test.mjs tests/desktop.test.mjs tests/heal.test.mjs",
        "lint": "eslint app lib desktop vite.desktop.config.ts",
        "build:desktop": "vite build --config vite.desktop.config.ts",
        "desktop": "npm run build:desktop && electron .",
        "package:windows": "npm run build:desktop && electron-builder --config electron-builder.json --win --x64 --publish never",
        "test:desktop": "node tests/desktop-smoke.mjs",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "react": "19.2.6",
        "react-dom": "19.2.6"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "electron": "44.4.5",
        "electron-builder": "26.15.3",
        "eslint": "9.39.4",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "16.4.0",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.59.3",
        "vite": "8.3.2"
    },
    "type": "module"
}
